# Neon Serverless PostgreSQL Database URL
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-ENDPOINT-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# AI Provider (Gemini / OpenAI)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Web Search Provider (Optional: Serper or Tavily)
SERPER_API_KEY=""
TAVILY_API_KEY=""

# Gmail OAuth credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3005/api/auth/callback/google"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3005"
